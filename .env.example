# PostgreSQL 数据库
# DATABASE_URL 用于脱离 Compose 启动 server；Compose 会根据以下三项生成容器内连接地址。
# POSTGRES_PASSWORD 会直接进入 URL，只能使用 URL 非保留字符（A-Z、a-z、0-9、点、下划线、波浪号和连字符），并通过秘密管理器注入生产值。
DATABASE_URL=
POSTGRES_DB=super_admin
POSTGRES_USER=super_admin
POSTGRES_PASSWORD=

# 默认只发布前端端口；数据库、队列、对象存储、邮件和 API 仅容器网络可访问。
CLIENT_PORT=80

# 会话与加密密钥
# 以下两项是必填秘密。所有环境都应独立生成，生产环境必须通过秘密管理器注入。
# JWT_ACCESS_SECRET 至少 32 个字符；TOKEN_ENCRYPTION_KEY 必须是 32 字节对应的 64 位十六进制字符串。
JWT_ACCESS_SECRET=
TOKEN_ENCRYPTION_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 兼容对象存储
# 本地可指向 MinIO；桶名只使用小写字母、数字、点和连字符，点不能连续或与连字符相邻，也不能使用 IPv4 格式。
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=learning-assistant
# 访问凭据是必填秘密。本地使用自建的非生产凭据，生产环境必须替换并由秘密管理器注入。
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# MinIO 根凭据只用于初始化桶、用户与策略；server 不得使用。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# SMTP 邮件服务
# Compose 中 Mailpit 默认监听 1025 且不启用 TLS；脱离 Compose 在宿主机运行 server 时将主机改为 localhost。
# 生产部署叠加 docker-compose.production.yml 后，以下四项均为必填且 Mailpit 不会启动。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@example.test

# 应用公开地址
# 用于生成邮件链接；生产环境必须替换为可由用户访问的 HTTPS 地址。
APP_PUBLIC_URL=http://localhost:5173

# Chrome 扩展 ID
# 这是公开标识，不是秘密；使用其他扩展构建时按实际 ID 替换。
VITE_EXTENSION_ID=moelbdnbfakngfdfmhlhpnkofdamccoa
